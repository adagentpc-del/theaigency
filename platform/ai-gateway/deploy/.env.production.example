# Copy to .env.production on the production host. Never commit the real file.
API_DOMAIN=api.theaigincy.com
ACME_EMAIL=you@example.com

# Shared default model. Individual apps can override this in the registry/env.
LOCAL_LLM_MODEL=qwen3:4b
LOCAL_LLM_TIMEOUT_MS=30000

# Public gateway controls
MAX_BODY_BYTES=20000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
TRUST_PROXY_HOPS=1

# Optional only if your private inference endpoint itself requires auth.
# LOCAL_LLM_API_KEY=

# Example future app-specific model override:
# SHOULD_I_TEXT_HIM_MODEL=qwen3:8b
